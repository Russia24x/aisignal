# ============================================================
# PenguSignals — Environment Configuration
# Copy to .env and adjust.
#
# v4 STATELESS: there is NO database — do not look for DATABASE_URL.
# Market data: fetched live + in-memory cache. Entitlements: signed
# sessions. History: deterministic recompute. Payments: on-chain.
#
# BUILD NOTE: every var below EXCEPT SESSION_SECRET has a safe default in
# src/lib/config.ts, so `bun run build` (opennextjs-cloudflare) succeeds in
# CI with an empty environment. SESSION_SECRET is runtime-only and must
# be set where the app runs — never at build time.
# ============================================================

# --- Core ---
APP_NAME="PenguSignals"
APP_URL="http://localhost:3000"
# Hex secret (>= 32 chars). Generate: openssl rand -hex 32
# REQUIRED AT RUNTIME (dev: this file — Cloudflare: wrangler secret put).
# Missing it makes auth/verify/quote endpoints fail with a clear error,
# and GET /api reports sessionConfigured:false.
SESSION_SECRET="dev-only-secret-change-me-9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e7d6"
# Log level: debug | info | warn | error
LOG_LEVEL="info"

# --- Abstract Chain (defaults: Abstract mainnet — public constants) ---
NEXT_PUBLIC_CHAIN_ID="2741"
NEXT_PUBLIC_RPC_URL="https://api.mainnet.abs.xyz"
NEXT_PUBLIC_EXPLORER_URL="https://abscan.org"

# --- Tokens & Payments (defaults: verified mainnet values) ---
# PENGU ERC-20 on Abstract mainnet (verified: 18 decimals)
NEXT_PUBLIC_PENGU_TOKEN="0x9eBe3A824Ca958e4b3Da772D2065518F009CBa62"
# Treasury wallet that receives all payments
NEXT_PUBLIC_TREASURY="0x60Df4E186364c3a49A550Aee29Da1d5fe3658818"
# Tariff (v4 access passes) lives in src/lib/modules/access/passes.ts —
# the single source of truth shared by client and server. No env vars needed.
# Token registry (PENGU / ETH / USDC.e) lives in src/lib/modules/access/tokens.ts.

# --- Market Data (cache TTLs, plan §13 freshness ladder) ---
MARKET_CACHE_TTL_MS="60000"
HISTORY_CACHE_TTL_MS="900000"
DATA_FETCH_TIMEOUT_MS="15000"
SIGNAL_TF_TTL_15M_MS="30000"
SIGNAL_TF_TTL_1H_MS="60000"
SIGNAL_TF_TTL_4H_MS="120000"
SIGNAL_TF_TTL_1D_MS="120000"

# --- Payments ---
# How long an HMAC-signed non-PENGU quote stays acceptable, and the
# tolerated downward slippage vs. the quote (percent).
PAYMENT_QUOTE_TTL_MS="1800000"
PAYMENT_SLIPPAGE_PCT="3"

# --- On-chain entitlement recovery (eth_getLogs treasury scan) ---
RESTORE_SCAN_LOOKBACK_DAYS="400"
RESTORE_SCAN_CHUNK_BLOCKS="4000000"
RESTORE_CACHE_TTL_MS="600000"

# --- Rate limits (requests per window per IP) ---
RATE_LIMIT_AUTH="30/60000"
RATE_LIMIT_PAYMENT="10/60000"
RATE_LIMIT_SIGNAL="30/60000"
RATE_LIMIT_PUBLIC="120/60000"
RATE_LIMIT_RESTORE="6/300000"

# --- Session ---
SESSION_TTL_HOURS="168"

# --- i18n ---
NEXT_PUBLIC_DEFAULT_LOCALE="fa"
NEXT_PUBLIC_SUPPORTED_LOCALES="fa,en"

# --- Client-side public config ---
NEXT_PUBLIC_APP_NAME="PenguSignals"
