// PenguSignals database schema
// Local dev: SQLite. For Cloudflare D1 deployment see docs/DEPLOYMENT.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A wallet-based user account. One row per unique address.
model User {
  id          String        @id @default(cuid())
  /// checksummed lowercase address (unique identity)
  address     String        @unique
  /// when platform access (5 PENGU tariff) was granted, if ever
  platformAccessAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  loginCount  Int           @default(1)
  lastLoginAt DateTime      @default(now())
  payments    Payment[]
  grants      AccessGrant[]
  sessions    AuthSession[]
}

/// One-time SIWE nonce (replay protection).
model Nonce {
  id        String    @id @default(cuid())
  nonce     String    @unique
  /// optional pre-binding to an address
  address   String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

/// Refresh-token rotation record (hardens session revocation).
model AuthSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String @unique
  userAgent   String?
  ipHash      String?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  revokedAt   DateTime?

  @@index([userId])
}

/// A verified on-chain PENGU payment (ERC-20 Transfer).
model Payment {
  id          String   @id @default(cuid())
  /// unique tx hash — prevents double-crediting the same transfer
  txHash      String   @unique
  chainId     Int
  fromAddress String
  toAddress   String
  token       String
  amountRaw   String
  amountToken Float
  product     String
  status      String   @default("VERIFIED")
  blockNumber BigInt?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  verifiedAt  DateTime @default(now())

  @@index([userId])
  @@index([fromAddress])
}

/// Time-bounded access granted to a user (day pass or subscription span).
model AccessGrant {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DAY_PASS | SUBSCRIPTION
  product         String
  startsAt        DateTime
  expiresAt       DateTime
  sourcePaymentId String?
  createdAt       DateTime @default(now())

  @@index([userId, expiresAt])
}

/// The daily trading signal — generated once per UTC day, shared by all
/// paying users, and stored to build a real track record.
model Signal {
  id             String    @id @default(cuid())
  /// UTC day key, e.g. "2026-06-30" — one signal per day
  day            String    @unique
  /// BUY | SELL | HOLD
  action         String
  /// 0..100
  confidence     Float
  /// -100..100 composite engine score
  score          Float
  /// reference price at generation time
  price          Float
  entryLow       Float?
  entryHigh      Float?
  stopLoss       Float?
  takeProfit1    Float?
  takeProfit2    Float?
  /// JSON: { fa: "...", en: "..." } localized reasoning
  reasoning      String
  /// full indicator snapshot JSON (transparency + auditability)
  indicatorsJson String
  /// data-quality factor 0..1 applied to confidence
  dataQuality    Float     @default(1)
  generatedAt    DateTime  @default(now())
  /// OPEN | WIN | LOSS | EXPIRED — evaluated T+24h by performance tracker
  outcome        String    @default("OPEN")
  outcomePrice   Float?
  evaluatedAt    DateTime?

  /// seconds taken to generate (ops metric)
  generationMs   Int       @default(0)
}

/// Engine weight snapshots — the exact weights used for each day's signal,
/// so historical signals remain explainable if weights evolve.
model EngineSnapshot {
  id        String   @id @default(cuid())
  day       String
  weightsJson String
  createdAt DateTime @default(now())

  @@index([day])
}

/// User-defined price alert. Triggered by the alert-checker when the live
/// PENGU price crosses the user-defined target in the chosen direction.
model PriceAlert {
  id           String    @id @default(cuid())
  userId       String
  /// "ABOVE" → fire when priceUsd >= target ; "BELOW" → fire when priceUsd <= target
  direction    String
  /// target price in USD (float — PENGU is a low-magnitude token)
  target       Float
  /// whether the alert is still actively monitoring
  active       Boolean   @default(true)
  /// null until first triggered
  triggeredAt  DateTime?
  /// the price at which it fired (for auditability)
  triggeredPrice Float?
  createdAt    DateTime  @default(now())

  @@index([userId, active])
  @@index([direction, active])
}
